# ---------------------------------------------------------------------------
# Job Scout — environment variables
# Copy this file to `.env.local` and fill in the values. Never commit `.env.local`.
# (This template is committed, so keep REAL secrets out of it — placeholders only.)
# ---------------------------------------------------------------------------

# --- Supabase (create a NEW project at https://supabase.com/dashboard) ---
# Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Settings -> API -> Project API keys -> anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Settings -> API -> Project API keys -> service_role  (SERVER ONLY, keep secret)
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (free tiers — you only need ONE of these for Phase 1) ---
# Google AI Studio free key: https://aistudio.google.com/apikey  (recommended, priority 1)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Embedding model powering semantic job matching (Gemini free tier).
EMBEDDING_MODEL=gemini-embedding-001

# Optional free fallbacks (leave blank if you don't have them)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# Optional paid fallback — last resort so the app never goes dark.
# Point PAID_LLM_BASE at any OpenAI-compatible endpoint (OpenAI, Anthropic-compat gateway, etc.)
PAID_LLM_API_KEY=
PAID_LLM_MODEL=gpt-4o-mini
PAID_LLM_BASE=https://api.openai.com/v1

# --- Scout (Phase 2) ---
# Secret protecting the /api/cron/scout endpoint. Set the same value in Vercel;
# Vercel Cron sends it automatically as an Authorization: Bearer header.
CRON_SECRET=
# --- Warm channel: right-person discovery (Pillar #3) ---
# A free GitHub token (Settings -> Developer settings -> Fine-grained token,
# public read only) lifts the API limit so the warm channel can find real
# engineers at target companies to reach for a referral. Without it, warm
# targets stay company-level (aimed at the founder / hiring lead).
GITHUB_TOKEN=

# Optional: extra company job boards to pull (comma-separated board tokens).
# RemoteOK, WeWorkRemotely, Remotive, Arbeitnow, Jobicy, and HN Who's-Hiring
# need no config; these just add specific company boards on top.
GREENHOUSE_BOARDS=anthropic,gitlab,figma,discord
ASHBY_BOARDS=openai,ramp,linear,replicate
# Opt-in (enterprise-heavy, off by default) — add company slugs to track them.
LEVER_BOARDS=
SMARTRECRUITERS_BOARDS=

# --- Email: outbound + inbound (Phase 3/4) via Resend ---
# Create a key at https://resend.com and verify a sending domain.
RESEND_API_KEY=
# The dedicated address applications are sent FROM (on your verified domain).
APPLICATION_FROM_EMAIL=apply@yourdomain.com
# Where replies land / your inbound address (defaults to FROM if unset).
APPLICATION_INBOX=apply@yourdomain.com
# Shared secret protecting the inbound-email webhook (set the same at your provider).
INBOUND_SECRET=

# --- App ---
APP_URL=http://localhost:3000
