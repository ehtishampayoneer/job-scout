# ---------------------------------------------------------------------------
# Job Scout — environment variables TEMPLATE (committed to git).
# Copy this file to `.env.local` and put your REAL values there.
# `.env.local` is git-ignored and never uploaded. Keep REAL secrets OUT of this
# template — placeholders only. For production, set these in Vercel's env settings.
# ---------------------------------------------------------------------------

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (free tiers — you only need Gemini for the basics) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
EMBEDDING_MODEL=gemini-embedding-001
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free

# --- Optional paid LLM fallback ---
PAID_LLM_API_KEY=
PAID_LLM_MODEL=gpt-4o-mini
PAID_LLM_BASE=https://api.openai.com/v1

# --- Scout ---
CRON_SECRET=
GREENHOUSE_BOARDS=anthropic,gitlab,figma,discord
ASHBY_BOARDS=openai,ramp,linear,replicate
LEVER_BOARDS=
SMARTRECRUITERS_BOARDS=

# --- Cross-platform aggregators (OPTIONAL but HIGH IMPACT) ---
# These pull in the same jobs you'd see on Indeed / LinkedIn / Glassdoor /
# ZipRecruiter via legitimate APIs. Each is FREE and activates the moment its
# key is present — leave blank to skip that source.
#
# JSearch = Google for Jobs (indexes Indeed, LinkedIn, Glassdoor, ZipRecruiter).
#   Get a free key at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=
# Adzuna — millions of aggregated listings across countries.
#   Get free app_id + app_key at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=us,gb
# Jooble — another large cross-platform aggregator.
#   Get a free key at https://jooble.org/api/about
JOOBLE_KEY=

# --- Warm channel (GitHub public read token) ---
GITHUB_TOKEN=

# --- Email (Resend) ---
RESEND_API_KEY=
APPLICATION_FROM_EMAIL=apply@yourdomain.com
APPLICATION_INBOX=apply@yourdomain.com
INBOUND_SECRET=

# --- App ---
APP_URL=http://localhost:3000
